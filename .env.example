# --- API бедолаги (сервисный токен из админки бота) ---
BEDOLAGA_API_URL=http://remnawave_bot:8080
BEDOLAGA_API_TOKEN=
# Таймзона дат, которые API отдал без таймзоны. Актуальные версии бота всегда
# отдают дату с таймзоной, и трогать это не нужно. Если в логе появилось
# «API отдаёт даты без таймзоны» — поставьте сюда зону, в которой писалась БД
# бота (например Europe/Moscow), иначе дебаунс будет считаться неверно.
API_TZ=UTC

# --- Кабинет: служебный аккаунт ---
# Аккаунт кабинета с ролью только на чтение (плюс ответ в тикет). Через него
# доступны каталог тарифов и список устройств, которых webapi-токен не отдаёт.
# Заводится в админке: Роли и права → создать роль, затем обычная регистрация
# по почте и назначение роли этому пользователю.
CABINET_EMAIL=
CABINET_PASSWORD=

# --- LLM ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Модель. Список доступного — GET /v1/models вашим ключом.
# Проверено на шести типовых обращениях (ответ по базе, деньги, просьба
# оператора, вопрос не из базы, действие в аккаунте, вопрос по аккаунту):
#   gpt-5.6-luna  — все шесть верно, честно занижает уверенность, когда
#                   ответа в базе нет; короткие ответы, кеш префикса 98%
#   gpt-5.4-mini  — все шесть верно, ответы вдвое длиннее
#   gpt-5.4-nano  — все шесть верно, но уверенность шумная, с порогом
#                   отсечения работать сложнее
#   gpt-4.1-mini  — НЕ БРАТЬ: выдумала инструкцию, которой нет в базе,
#                   с уверенностью 0.90
LLM_MODEL=gpt-5.6-luna
# Необязательно: свой шлюз/прокси, совместимый с OpenAI API.
# ВНИМАНИЕ: строку с пустым значением оставлять НЕЛЬЗЯ. Клиент OpenAI читает эту
# переменную из окружения сам, минуя настройки приложения, и пустая строка даёт
# пустой base_url: любой вызов падает с APIConnectionError, хотя сеть исправна.
# Нужен свой шлюз — раскомментируйте и впишите адрес. Не нужен — не трогайте.
#OPENAI_BASE_URL=https://example.com/v1

# --- Режим работы ---
# false = shadow: сервис всё считает и пишет в TG-топик, но клиенту НЕ отвечает
AI_REPLY_ENABLED=false
# Как модель называет сервис в ответах, например «VPN-сервиса Название».
# Пусто — будет нейтральное «сервиса».
BRAND_NAME=
# true = в тикетах, которые взял человек, продолжать считать черновики
# для оператора и присылать их в топик (клиенту сервис не пишет и в этом
# режиме). Каждый новый вопрос клиента в таком тикете — отдельный вызов модели.
HUMAN_ASSIST_ENABLED=false
# true = на черновиках в топике появляется кнопка «Отправить клиенту»:
# нажатие отправляет текст в тикет от имени поддержки, копировать не нужно.
# Требует настроенного наблюдения (TG_BOT_TOKEN/TG_CHAT_ID), а бот-наблюдатель
# не должен использоваться другими потребителями getUpdates или вебхуком.
# Кнопку получают только черновики, прошедшие пост-фильтр (без запрещённых
# ссылок, сумм и стоп-слов) — остальные остаются просто копируемым текстом.
DRAFT_SEND_BUTTON=false

# --- Цикл ---
POLL_INTERVAL_SEC=60
# Не трогаем тикет, пока последнее сообщение свежее этого — юзер может ещё дописывать
DEBOUNCE_SEC=45
MAX_AI_REPLIES=2
CONFIDENCE_THRESHOLD=0.7
MAX_REPLY_CHARS=1500

# --- Пост-фильтр ответа ---
# Домены, которые модели разрешено называть. Пусто = никаких ссылок в ответе.
# Указываются только хосты, поддомены разрешаются вместе с доменом.
# Пример: ALLOWED_DOMAINS=t.me,example.com
ALLOWED_DOMAINS=
# Слова, при которых ответ уходит оператору. Пусто — список по умолчанию:
# возврат, верну деньги, компенсац
STOP_WORDS=

# --- Наблюдение: топик в админ-форуме ---
# Сколько сбоев подряд (упавших циклов или ошибок модели) терпим молча
ALERT_AFTER_FAILURES=3
# Не повторяем алерт об одной и той же беде чаще, чем раз в это время
ALERT_COOLDOWN_SEC=3600
# Час (в таймзоне API_TZ), когда в топик уходит сводка за сутки. Пусто — не шлём
DIGEST_HOUR=
# Токен отдельного бота-наблюдателя, НЕ основного бота: у основного висит
# вебхук на его же канал обновлений, и кнопка «Отправить клиенту» с таким
# токеном работать не будет (Telegram не отдаёт нажатия рядом с вебхуком).
TG_BOT_TOKEN=
TG_CHAT_ID=
TG_TOPIC_ID=

# --- Прочее ---
STATE_PATH=/data/state.db
# Сколько дней хранить аудит (в нём переписка клиентов). 0 — не чистить
AUDIT_RETENTION_DAYS=90
# Отметка живости для HEALTHCHECK, обновляется в конце каждого цикла
HEARTBEAT_PATH=/data/heartbeat
# FAQ тянется живьём из админки бота; тут только языки, которые забираем
KB_LANGUAGES=ru
KB_CACHE_PATH=/data/faq-cache.json
# Локальные гайды под то, чего нет во FAQ
KB_DIR=kb
LOG_LEVEL=INFO
